{
  --background: #0B1220;
  --surface: #111C30;
  --primary: #2563EB;
  --primary-hover: #1D4ED8;
  --accent: #10B981;
  --gold: #F59E0B;
  --text: #F8FAFC;
  --muted: #B8C4D6;
  --border: #29384F;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 20px;
}

body {
  font-family: Arial, sans-serif;
  margin: 0;
  line-height: 1.7;
  color: var(--text);
  background: var(--background);
}

/* Website header */
header {
  background: linear-gradient(135deg, #111C30, #1D4ED8);
  color: white;
  padding: 45px 20px;
  text-align: center;
  border-bottom: 3px solid var(--accent);
}

/* Navigation links */
nav {
  padding: 15px 10px;
  background: var(--surface);
  text-align: center;
  border-bottom: 1px solid var(--border);
}

nav a {
  display: inline-block;
  color: var(--text);
  margin: 5px 10px;
  text-decoration: none;
  font-weight: bold;
  transition: color 0.2s ease;
}

nav a:hover {
  color: var(--accent);
}

/* Main content */
main {
  max-width: 1000px;
  margin: 35px auto;
  padding: 0 24px;
}

/* Section headings */
h1, h2, h3 {
  line-height: 1.3;
  color: var(--text);
}

h2 {
  border-left: 4px solid var(--accent);
  padding-left: 12px;
}

p {
  color: var(--muted);
}

/* Links */
a {
  color: #60A5FA;
}

a:hover {
  color: var(--accent);
}

/* Images */
img {
  max-width: 100%;
  height: auto; border-radius: 12px;
}







