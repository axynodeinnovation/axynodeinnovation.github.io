{
  --background: #0B1220;
  --surface: #111C30;
  --primary: #2563EB;
  --primary-hover: #1D4ED8;
  --accent: #10B981;
  --gold: #F59E0B;
  --text: #F8FAFC;
  --muted: #B8C4D6;
  --border: #29384F;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 20px;
}

body {
  font-family: Arial, sans-serif;
  margin: 0;
  line-height: 1.7;
  color: var(--text);
  background: var(--background);
}

/* Website header */
header {
  background: linear-gradient(135deg, #111C30, #1D4ED8);
  color: white;
  padding: 45px 20px;
  text-align: center;
  border-bottom: 3px solid var(--accent);
}

/* Navigation links */
nav {
  padding: 15px 10px;
  background: var(--surface);
  text-align: center;
  border-bottom: 1px solid var(--border);
}

nav a {
  display: inline-block;
  color: var(--text);
  margin: 5px 10px;
  text-decoration: none;
  font-weight: bold;
  transition: color 0.2s ease;
}

nav a:hover {
  color: var(--accent);
}

/* Main content */
main {
  max-width: 1000px;
  margin: 35px auto;
  padding: 0 24px;
}

/* Section headings */
h1, h2, h3 {
  line-height: 1.3;
  color: var(--text);
}

h2 {
  border-left: 4px solid var(--accent);
  padding-left: 12px;
}

p {
  color: var(--muted);
}

/* Links */
a {
  color: #60A5FA;
}

a:hover {
  color: var(--accent);
}

/* Images */
img {
  max-width: 100%;
  height: auto; border-radius: 12px;
}

/* Optional project cards */
.card, .project-card, .service-card {
  background: var(--surface);
  padding: 24px;
  margin: 20px 0;
  border: 1px solid var(--border);
  border-radius: 14px;
  transition: transform 0.25s ease,
              border-color 0.25s ease;
}

.card:hover, .project-card:hover,
.service-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
}

/* Optional buttons */
button, .btn {
  display: inline-block;
  background: var(--primary);
  color: white;
  padding: 12px 22px;
  border: none;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;
  cursor: pointer;
}

button:hover, .btn:hover {
  background: var(--primary-hover);
}

/* Footer */
footer {
  text-align: center;
  padding: 25px 20px;
  background: var(--surface);
  color: var(--muted);
  border-top: 1px solid var(--border);
  margin-top: 40px;
}/* Mobile-friendly design */
@media (max-width: 600px) {
  header {
    padding: 30px 15px;
  }

  nav a {
    margin: 6px 8px;
    font-size: 14px;
  }

  main {
    margin: 25px auto;
    padding: 0 16px;
  }

  .card, .project-card, .service-card {
    padding: 18px;
  }
}




